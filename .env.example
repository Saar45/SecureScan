# MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=security_scanner
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

# Symfony
APP_ENV=dev
APP_SECRET=change_me_to_a_random_secret
CORS_ALLOW_ORIGIN=http://localhost:3000

# Git Integration
GIT_TOKEN=

# GitHub OAuth (redirect_uri doit correspondre exactement à l'URL configurée dans GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optionnel : URL de callback (défaut http://localhost:3000/api/auth/github/callback)
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# AI (Groq — Llama 3.3 70B)
GROQ_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8080
